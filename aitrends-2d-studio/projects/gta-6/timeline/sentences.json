[
 {
  "i": 0,
  "start": 0.0,
  "end": 4.42,
  "text": "Sua mãe acabou de fazer a proposta mais perigosa da sua vida."
 },
 {
  "i": 1,
  "start": 4.9,
  "end": 11.5,
  "text": "Você tem catorze anos e um talento raro: passar seis horas seguidas no videogame sem piscar."
 },
 {
  "i": 2,
  "start": 11.94,
  "end": 13.66,
  "text": "Na escola, o talento é outro."
 },
 {
  "i": 3,
  "start": 14.06,
  "end": 15.34,
  "text": "Português: quatro."
 },
 {
  "i": 4,
  "start": 15.94,
  "end": 17.14,
  "text": "História: três."
 },
 {
  "i": 5,
  "start": 17.78,
  "end": 18.5,
  "text": "Matemática..."
 },
 {
  "i": 6,
  "start": 19.14,
  "end": 19.52,
  "text": "dois."
 },
 {
  "i": 7,
  "start": 20.22,
  "end": 23.18,
  "text": "E o dois ainda veio com um bilhete da professora."
 },
 {
  "i": 8,
  "start": 23.64,
  "end": 27.44,
  "text": "Aí, no jantar, ela solta: \"Quer o GTA 6?"
 },
 {
  "i": 9,
  "start": 27.44,
  "end": 27.98,
  "text": "Eu compro."
 },
 {
  "i": 10,
  "start": 27.98,
  "end": 30.28,
  "text": "Quase quatrocentos e cinquenta reais."
 },
 {
  "i": 11,
  "start": 30.76,
  "end": 33.78,
  "text": "Mas só se você fechar o ano com média sete."
 },
 {
  "i": 12,
  "start": 33.78,
  "end": 34.44,
  "text": "Em tudo.\""
 },
 {
  "i": 13,
  "start": 35.08,
  "end": 36.28,
  "text": "Você faz as contas."
 },
 {
  "i": 14,
  "start": 36.64,
  "end": 38.24,
  "text": "Mal, porque é matemática."
 },
 {
  "i": 15,
  "start": 38.66,
  "end": 39.08,
  "text": "Mas faz."
 },
 {
  "i": 16,
  "start": 39.56,
  "end": 40.24,
  "text": "Quatro semanas."
 },
 {
  "i": 17,
  "start": 40.82,
  "end": 42.02,
  "text": "Média sete."
 },
 {
  "i": 18,
  "start": 42.02,
  "end": 42.92,
  "text": "Partindo do dois."
 },
 {
  "i": 19,
  "start": 43.42,
  "end": 46.68,
  "text": "E seus amigos já combinaram de jogar juntos no lançamento."
 },
 {
  "i": 20,
  "start": 46.96,
  "end": 48.52,
  "text": "Sem você, se der errado."
 },
 {
  "i": 21,
  "start": 49.0,
  "end": 52.8,
  "text": "Na primeira noite, você abre o caderno e fecha em três minutos."
 },
 {
  "i": 22,
  "start": 53.32,
  "end": 54.94,
  "text": "Na segunda, vem a ideia."
 },
 {
  "i": 23,
  "start": 54.94,
  "end": 56.66,
  "text": "E se estudar fosse..."
 },
 {
  "i": 24,
  "start": 56.66,
  "end": 58.0,
  "text": "uma missão?"
 },
 {
  "i": 25,
  "start": 58.64,
  "end": 60.82,
  "text": "A lista de exercícios vira um assalto."
 },
 {
  "i": 26,
  "start": 61.08,
  "end": 63.5,
  "text": "Cada conta certa, dinheiro no bolso."
 },
 {
  "i": 27,
  "start": 63.78,
  "end": 65.74,
  "text": "A tabuada vira treino de mira."
 },
 {
  "i": 28,
  "start": 66.12,
  "end": 66.9,
  "text": "O livro de História?"
 },
 {
  "i": 29,
  "start": 67.42,
  "end": 68.84,
  "text": "Mapa do território inimigo."
 },
 {
  "i": 30,
  "start": 69.06,
  "end": 69.74,
  "text": "E a prova..."
 },
 {
  "i": 31,
  "start": 69.74,
  "end": 70.9,
  "text": "é o chefão."
 },
 {
  "i": 32,
  "start": 71.28,
  "end": 74.66,
  "text": "Pela primeira vez, você deixa o controle desligado."
 },
 {
  "i": 33,
  "start": 75.0,
  "end": 77.64,
  "text": "E, estranhamente, não morre por isso."
 },
 {
  "i": 34,
  "start": 78.0,
  "end": 80.04,
  "text": "Aí vem o simulado de matemática."
 },
 {
  "i": 35,
  "start": 80.32,
  "end": 81.02,
  "text": "Você treinou."
 },
 {
  "i": 36,
  "start": 81.36,
  "end": 82.22,
  "text": "Você confia."
 },
 {
  "i": 37,
  "start": 82.22,
  "end": 84.12,
  "text": "Nota: cinco."
 },
 {
  "i": 38,
  "start": 84.12,
  "end": 87.16,
  "text": "Você joga a mochila no canto e pensa: \"Pronto."
 },
 {
  "i": 39,
  "start": 87.64,
  "end": 88.14,
  "text": "Game over.\""
 },
 {
  "i": 40,
  "start": 88.62,
  "end": 94.84,
  "text": "Só que game over, você sabe melhor que ninguém, significa uma coisa só: tentar de novo."
 },
 {
  "i": 41,
  "start": 95.26,
  "end": 96.48,
  "text": "Você volta pro checkpoint."
 },
 {
  "i": 42,
  "start": 97.1,
  "end": 98.78,
  "text": "Refaz cada questão errada."
 },
 {
  "i": 43,
  "start": 99.16,
  "end": 100.04,
  "text": "Uma por uma."
 },
 {
  "i": 44,
  "start": 100.56,
  "end": 101.56,
  "text": "Último dia de aula."
 },
 {
  "i": 45,
  "start": 101.88,
  "end": 103.4,
  "text": "Boletim na mão da sua mãe."
 },
 {
  "i": 46,
  "start": 103.76,
  "end": 105.02,
  "text": "Ela lê em silêncio."
 },
 {
  "i": 47,
  "start": 105.36,
  "end": 106.8,
  "text": "Português: oito."
 },
 {
  "i": 48,
  "start": 107.24,
  "end": 108.84,
  "text": "História: sete e meio."
 },
 {
  "i": 49,
  "start": 109.3,
  "end": 109.96,
  "text": "Matemática..."
 },
 {
  "i": 50,
  "start": 110.54,
  "end": 111.04,
  "text": "Sete."
 },
 {
  "i": 51,
  "start": 111.66,
  "end": 112.26,
  "text": "Raspando."
 },
 {
  "i": 52,
  "start": 112.26,
  "end": 113.34,
  "text": "Mas sete."
 },
 {
  "i": 53,
  "start": 113.7,
  "end": 118.48,
  "text": "No fim de semana, a barra de download do GTA 6 chega a cem por cento."
 },
 {
  "i": 54,
  "start": 118.48,
  "end": 120.22,
  "text": "E você liga o console, claro."
 },
 {
  "i": 55,
  "start": 120.72,
  "end": 126.7,
  "text": "Mas tem uma coisa que você não conta pra ninguém: a melhor fase da semana não foi abrir o jogo."
 },
 {
  "i": 56,
  "start": 127.06,
  "end": 128.2,
  "text": "Foi ver aquele sete."
 },
 {
  "i": 57,
  "start": 129.08,
  "end": 129.48,
  "text": "E você?"
 },
 {
  "i": 58,
  "start": 129.92,
  "end": 130.94,
  "text": "Aceitaria o acordo?"
 },
 {
  "i": 59,
  "start": 131.38,
  "end": 132.3,
  "text": "Porque a sua mãe..."
 },
 {
  "i": 60,
  "start": 132.3,
  "end": 136.26,
  "text": "acabou de fazer a proposta mais perigosa da sua vida."
 }
]