[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.04,
  "text": "E se você fosse técnico do Corinthians por um dia?"
 },
 {
  "i": 1,
  "start": 3.56,
  "end": 6.42,
  "text": "Porra, logo na quarta contra o Galo?"
 },
 {
  "i": 2,
  "start": 6.92,
  "end": 10.08,
  "text": "Parabéns, já pode ir escrevendo o discurso de despedida."
 },
 {
  "i": 3,
  "start": 10.72,
  "end": 12.46,
  "text": "Oito da manhã, você assume."
 },
 {
  "i": 4,
  "start": 12.88,
  "end": 13.7,
  "text": "Dorival caiu."
 },
 {
  "i": 5,
  "start": 14.1,
  "end": 14.96,
  "text": "Diniz caiu."
 },
 {
  "i": 6,
  "start": 15.24,
  "end": 16.12,
  "text": "Você é o próximo."
 },
 {
  "i": 7,
  "start": 16.66,
  "end": 17.88,
  "text": "Puta que pariu."
 },
 {
  "i": 8,
  "start": 18.5,
  "end": 20.74,
  "text": "Nove horas, você pede reforço."
 },
 {
  "i": 9,
  "start": 21.06,
  "end": 23.76,
  "text": "A dívida é de 2,7 bilhões."
 },
 {
  "i": 10,
  "start": 24.16,
  "end": 26.96,
  "text": "Dá nem pra contratar um gandula parcelado, caralho."
 },
 {
  "i": 11,
  "start": 26.96,
  "end": 29.88,
  "text": "Dez horas, o salário de outubro atrasou."
 },
 {
  "i": 12,
  "start": 30.14,
  "end": 31.4,
  "text": "O seu nem pergunta."
 },
 {
  "i": 13,
  "start": 32.06,
  "end": 34.88,
  "text": "Meio dia, avião pra BH, turbulência."
 },
 {
  "i": 14,
  "start": 35.18,
  "end": 37.38,
  "text": "É a coisa mais estável do seu dia."
 },
 {
  "i": 15,
  "start": 37.78,
  "end": 40.04,
  "text": "Três da tarde, sábado tem eleição."
 },
 {
  "i": 16,
  "start": 40.44,
  "end": 42.54,
  "text": "Seu chefe pode cair antes de você."
 },
 {
  "i": 17,
  "start": 43.04,
  "end": 46.34,
  "text": "Seis da tarde, a campanha já foi pior que a do rebaixamento."
 },
 {
  "i": 18,
  "start": 46.9,
  "end": 48.64,
  "text": "Oito da noite, bola rola."
 },
 {
  "i": 19,
  "start": 48.96,
  "end": 50.5,
  "text": "Não deu nem trinta segundos."
 },
 {
  "i": 20,
  "start": 51.06,
  "end": 51.9,
  "text": "Gol do Galo."
 },
 {
  "i": 21,
  "start": 52.02,
  "end": 55.22,
  "text": "De um cara que não tinha feito um gol na temporada inteira."
 },
 {
  "i": 22,
  "start": 55.22,
  "end": 57.4,
  "text": "Na temporada inteira, porra."
 },
 {
  "i": 23,
  "start": 57.8,
  "end": 58.32,
  "text": "Oito e um."
 },
 {
  "i": 24,
  "start": 58.54,
  "end": 60.22,
  "text": "A Fiel já pediu sua cabeça."
 },
 {
  "i": 25,
  "start": 60.8,
  "end": 61.4,
  "text": "Intervalo."
 },
 {
  "i": 26,
  "start": 61.56,
  "end": 63.74,
  "text": "Você faz a palestra da sua vida."
 },
 {
  "i": 27,
  "start": 64.1,
  "end": 65.32,
  "text": "O time volta pior."
 },
 {
  "i": 28,
  "start": 65.92,
  "end": 69.16,
  "text": "Nove da noite, você olha pro banco procurando uma solução."
 },
 {
  "i": 29,
  "start": 69.5,
  "end": 70.84,
  "text": "O banco olha de volta."
 },
 {
  "i": 30,
  "start": 71.3,
  "end": 71.88,
  "text": "Mas calma."
 },
 {
  "i": 31,
  "start": 72.22,
  "end": 74.82,
  "text": "Quarta passada, quatro a zero no Botafogo."
 },
 {
  "i": 32,
  "start": 75.1,
  "end": 76.7,
  "text": "Hat-trick do Caio César."
 },
 {
  "i": 33,
  "start": 76.94,
  "end": 81.4,
  "text": "Corintiano te manda tomar no cu na segunda e te pede em casamento na quarta."
 },
 {
  "i": 34,
  "start": 81.78,
  "end": 84.12,
  "text": "No Corinthians, técnico não tem contrato."
 },
 {
  "i": 35,
  "start": 84.12,
  "end": 85.78,
  "text": "Tem prazo de validade."
 },
 {
  "i": 36,
  "start": 86.08,
  "end": 91.08,
  "text": "Se esse vexame acontece de verdade, quarta, oito da noite, a gente descobre."
 }
]