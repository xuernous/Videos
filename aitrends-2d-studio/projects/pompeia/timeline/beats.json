[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 4.88,
  "text": "E se você voltasse no tempo e acordasse padeiro em Pompeia, no ano 79,",
  "end": 5.67
 },
 {
  "i": 1,
  "start": 5.67,
  "speechStart": 5.82,
  "speechEnd": 7.26,
  "text": "são quase uma da tarde.",
  "end": 7.65
 },
 {
  "i": 2,
  "start": 7.65,
  "speechStart": 7.8,
  "speechEnd": 11.94,
  "text": "A montanha atrás da cidade acabou de explodir. Tem pão no forno.",
  "end": 12.19
 },
 {
  "i": 3,
  "start": 12.19,
  "speechStart": 12.34,
  "speechEnd": 16.54,
  "text": "Uma coluna de cinza sobe 30 quilômetros com a forma de um pinheiro.",
  "end": 16.91
 },
 {
  "i": 4,
  "start": 16.91,
  "speechStart": 17.06,
  "speechEnd": 21.64,
  "text": "O sol some, então começa a chover pedra sem parar.",
  "end": 22.01
 },
 {
  "i": 5,
  "start": 22.01,
  "speechStart": 22.16,
  "speechEnd": 23.58,
  "text": "Você tem duas escolhas.",
  "end": 23.89
 },
 {
  "i": 6,
  "start": 23.89,
  "speechStart": 24.04,
  "speechEnd": 30.32,
  "text": "Se trancar em casa e esperar passar, ou fugir no escuro, com um travesseiro amarrado na cabeça.",
  "end": 30.67
 },
 {
  "i": 7,
  "start": 30.67,
  "speechStart": 30.82,
  "speechEnd": 35.4,
  "text": "A chuva dura 18 horas, quase 3 metros de pedra.",
  "end": 35.67
 },
 {
  "i": 8,
  "start": 35.67,
  "speechStart": 35.82,
  "speechEnd": 38.58,
  "text": "De madrugada, os telhados começam a desabar.",
  "end": 38.85
 },
 {
  "i": 9,
  "start": 38.85,
  "speechStart": 39.0,
  "speechEnd": 44.26,
  "text": "Por volta da 7 da manhã, desce uma nuvem de gás e cinza a centenas de graus,",
  "end": 44.33
 },
 {
  "i": 10,
  "start": 44.33,
  "speechStart": 44.48,
  "speechEnd": 46.7,
  "text": "mais de 100 quilômetros por hora.",
  "end": 46.93
 },
 {
  "i": 11,
  "start": 46.93,
  "speechStart": 47.08,
  "speechEnd": 48.68,
  "text": "Ninguém corre mais que isso.",
  "end": 48.97
 },
 {
  "i": 12,
  "start": 48.97,
  "speechStart": 49.12,
  "speechEnd": 51.72,
  "text": "A maioria dos moradores fugiu enquanto dava.",
  "end": 52.03
 },
 {
  "i": 13,
  "start": 52.03,
  "speechStart": 52.18,
  "speechEnd": 53.62,
  "text": "Morreu quem esperou demais.",
  "end": 54.05
 },
 {
  "i": 14,
  "start": 54.05,
  "speechStart": 54.2,
  "speechEnd": 60.16,
  "text": "Seus pães foram encontrados quase 1.800 anos depois, ainda no forno.",
  "end": 60.47
 },
 {
  "i": 15,
  "start": 60.47,
  "speechStart": 60.62,
  "speechEnd": 65.16,
  "text": "E o pior, ninguém ali sabia que aquela montanha era um vulcão.",
  "end": 65.43
 },
 {
  "i": 16,
  "start": 65.43,
  "speechStart": 65.58,
  "speechEnd": 67.0,
  "text": "Agora você sabe.",
  "end": 68.5
 }
]